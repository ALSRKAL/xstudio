# ============================================================================
# X Studio - environment variables
# ----------------------------------------------------------------------------
# All keys are read by the Netlify Functions only (server side). They are never
# bundled into the browser build.
#
# For local development:  copy this file to `.env` and run `npm run dev`
# For production:         Netlify -> Site settings -> Environment variables
#
# You do NOT need any key to start: the app ships with a keyless provider.
# Adding one free key unlocks far better and faster models.
# ============================================================================

# --- Keyless (already works without a key; a free key only raises limits) ---
# https://llm7.io
# LLM7_API_KEY=

# --- Recommended free tiers (no credit card) --------------------------------

# Fastest inference, very generous free tier -> https://console.groq.com/keys
# GROQ_API_KEY=

# Google AI Studio (Gemini) free tier -> https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Very fast, free tier -> https://cloud.cerebras.ai
# CEREBRAS_API_KEY=

# Many free models behind a single key -> https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- Additional optional providers -----------------------------------------

# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# https://github.com/settings/tokens  (fine-grained token, "Models" read access)
# GITHUB_MODELS_TOKEN=

# https://build.nvidia.com
# NVIDIA_API_KEY=

# https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=
