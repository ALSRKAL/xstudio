# ============================================================================
# X Studio - environment variables
# ----------------------------------------------------------------------------
# Read by the Netlify Functions only (server side). Never bundled into the
# browser build, and never committed: copy this file to `.env` for local work.
#
# Local:      cp .env.example .env   then  npm run dev
# Production: Netlify -> Site settings -> Environment variables
# ============================================================================

# --- Primary provider -------------------------------------------------------
# One key unlocks the whole free catalogue (Nemotron 3 Ultra 1M ctx, Gemma 4,
# Laguna, Ling, gpt-oss and more). Get it at https://openrouter.ai/keys
#
# IMPORTANT: in OpenRouter -> Settings, leave the provider allow-list empty.
# If it lists specific providers, every free model answers
# 404 "No allowed providers are available for the selected model".
OPENROUTER_API_KEY=

# --- Optional extra text providers -----------------------------------------
# Each one simply adds its models to the picker.

# https://console.groq.com/keys           - fastest inference
# GROQ_API_KEY=

# https://aistudio.google.com/apikey      - Gemini free tier
# GEMINI_API_KEY=

# https://cloud.cerebras.ai               - very fast, free tier
# CEREBRAS_API_KEY=

# https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=

# https://github.com/settings/tokens      - fine-grained token, Models: read
# GITHUB_MODELS_TOKEN=

# https://build.nvidia.com
# NVIDIA_API_KEY=

# https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=

# https://llm7.io  - keyless emergency fallback; a key only raises its limit
# LLM7_API_KEY=

# --- Image providers --------------------------------------------------------
# Pollinations needs no key and is always available.

# https://dash.cloudflare.com/profile/api-tokens  - FLUX.1 schnell, free daily
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Together also serves a free FLUX endpoint with the key above.
